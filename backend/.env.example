# Server
PORT=5000
NODE_ENV=development

# Must match DEVICE_API_KEY in esp32/roomguard/roomguard.ino
DEVICE_API_KEY=change_this_to_a_long_random_string

# Optional: leave blank to use the built-in in-memory store (great for local dev).
# Set this to use real PostgreSQL, e.g.:
# postgres://username:password@localhost:5432/roomguard
DATABASE_URL=

# How long (seconds) without a heartbeat before a device is shown as OFFLINE
HEARTBEAT_TIMEOUT_SECONDS=60

# Comma-separated list of allowed origins, or * for all (fine for local dev)
CORS_ORIGIN=*
